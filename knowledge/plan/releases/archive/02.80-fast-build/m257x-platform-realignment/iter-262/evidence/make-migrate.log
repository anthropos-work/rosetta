         END IF;
       
         SELECT n.nspname
           INTO ext_schema
           FROM pg_extension e
           JOIN pg_namespace n ON e.extnamespace = n.oid
          WHERE e.extname = 'pg_trgm';
       
         -- Trigram GIN indexes on the three identifying columns. With gin_trgm_ops
         -- Postgres can serve `firstname ILIKE '%mar%'`, `email ILIKE '%@anthropos%'`
         -- and `similarity(firstname, 'mario') > 0.3` from an index scan instead of
         -- a sequential scan.
         EXECUTE format(

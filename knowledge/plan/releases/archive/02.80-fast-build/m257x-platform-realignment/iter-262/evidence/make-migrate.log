                                )
                                                                                                       as years,
                                COUNT(*) FILTER (WHERE user_skill_experience IS NOT NULL)              as work_experience_count,
                                COUNT(*) FILTER (WHERE user_skill_education IS NOT NULL)               as education_count,
                                COUNT(*) FILTER (WHERE user_skill_certification IS NOT NULL)           as certification_count,
                                COUNT(*) FILTER (WHERE user_skill_project IS NOT NULL)                 as project_count,
                                COUNT(*) FILTER (WHERE user_skill_volunteering IS NOT NULL)            as volunteering_count,
                                COUNT(*) FILTER (WHERE user_skill_content IS NOT NULL)                 as content_count,
                                COUNT(DISTINCT skill_path_id) FILTER (WHERE skill_path_id IS NOT NULL) as skill_path_count,

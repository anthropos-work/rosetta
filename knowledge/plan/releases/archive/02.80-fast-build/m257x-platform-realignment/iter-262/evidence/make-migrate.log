         );
         EXECUTE format(
           'CREATE INDEX IF NOT EXISTS "membership_lastname_trgm" ON "memberships" USING GIN ("lastname" %I.gin_trgm_ops)',
           ext_schema
         );
         EXECUTE format(
           'CREATE INDEX IF NOT EXISTS "membership_email_trgm" ON "memberships" USING GIN ("email" %I.gin_trgm_ops)',
           ext_schema
         );

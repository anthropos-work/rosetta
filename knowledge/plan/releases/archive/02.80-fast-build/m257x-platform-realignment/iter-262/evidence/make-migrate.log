               -- case memb deletion
               DELETE
               FROM membership_searches
               WHERE "membership_searches"."membership_search_membership" = new.id
                 AND "membership_searches"."membership_search_organization" = new.organization;
           else
               INSERT INTO membership_searches(membership_search_membership, membership_search_organization, email, firstname,
                                               lastname, location, job_role_id)
               select new."id",
                      new."organization",
                      "users".email,
                      "users".firstname,
                      "users".lastname,
                      "user_basic_info".location,
                      "user_basic_info".job_role_id
               from "memberships"
                        join "users" on "users".id = "memberships".user
                        join "user_basic_info" on "user_basic_info".id = "users".id
               where "memberships"."user" = new.user
                 and "memberships"."status" = 'active'
               ON CONFLICT (membership_search_membership, membership_search_organization)
                   DO UPDATE
                   SET firstname   = excluded.firstname,
                       lastname    = excluded.lastname,
                       email       = excluded.email,
                       location    = excluded.location,
                       job_role_id = excluded.job_role_id;
           end if;
           return new;
       end;
       $$;
